{
  "name": "dsh-remote-access-proxy",
  "version": "1.5.2",
  "type": "module",
  "description": "Reach the DSH Web GUI from your phone or another computer: a secret-path reverse proxy with an optional password and client allow list that bridges DSH's per-start launch token, configured from its own page in the Plugins panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-access",
    "reverse-proxy",
    "authentication"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydirector/dsh-remote-access-proxy.git"
  },
  "exports": {
    ".": "./plugin/dsh-remote-access-proxy.mjs",
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "cordis.patch.yml",
    "plugin/dsh-remote-access-proxy.mjs",
    "client/index.js",
    "config",
    "locale",
    "icon.svg",
    "test-remote-access-proxy.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=24.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-alpha.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "main": "./plugin/dsh-remote-access-proxy.mjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test-remote-access-proxy.mjs && node --test test/compatibility.spec.mjs"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}
