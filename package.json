{
  "name": "dsh-remote-access-proxy",
  "version": "1.4.1",
  "type": "module",
  "description": "Reach the DSH Web GUI from your phone or another computer: a secret-path reverse proxy with an optional password and client allow list that bridges DSH's per-start launch token, configured from its own page in the Plugins panel.",
  "license": "MIT",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydirector/dsh-remote-access-proxy.git"
  },
  "exports": {
    ".": "./plugin/dsh-remote-access-proxy.mjs",
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "cordis.patch.yml",
    "plugin/dsh-remote-access-proxy.mjs",
    "client/index.js",
    "config",
    "locale",
    "icon.svg",
    "test-remote-access-proxy.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "main": "./plugin/dsh-remote-access-proxy.mjs"
}
