{
  "name": "dsh-remote-access-proxy",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH web GUI remote-access proxy as a profile bundle: a random-path + HttpOnly-cookie reverse proxy with a DSH launch-token bridge, plus its configuration card.",
  "license": "MIT",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydirector/dsh-remote-access-proxy.git"
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "cordis.patch.yml",
    "plugin",
    "ui",
    "config",
    "locale",
    "icon.svg",
    "test-remote-access-proxy.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
